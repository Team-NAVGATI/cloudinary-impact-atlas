# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=sustainability-media-api

# Supabase (Database & Auth - for future steps)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (Media Storage & Delivery - for future steps)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# NVIDIA AI APIs (Vision & Inference - for future steps)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1
