# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=impact-atlas
# Public base URL used in emailed report links (defaults to the request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (media storage, AI Vision, transformations)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Image understanding order. Cloudinary AI Vision needs its add-on; NVIDIA needs a key;
# "heuristic" always works but is provisional.
VISION_PROVIDERS=cloudinary,nvidia,heuristic

# NVIDIA API (free keys at build.nvidia.com). Add as many as you have: calls are spread across them,
# each key limited to ~40 requests/minute (we stay under NVIDIA_RPM_PER_KEY), and a rate-limited or
# invalid key is skipped automatically. Used for report text and as the image-vision fallback.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_RPM_PER_KEY=34
NVIDIA_MODEL_ENDPOINT=https://integrate.api.nvidia.com/v1
# Multimodal embedding model: pictures and text share one space, so a description finds the photo itself.
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# Model chains are tried in order; models that are retired (404/410) or time out are skipped automatically.
# Defaults: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning, then nvidia/nemotron-3-super-120b-a12b.
# NVIDIA_TEXT_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-super-120b-a12b
# NVIDIA_VISION_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Email delivery (optional: resend.com). Without it, alerts are logged and links are shown for manual sending.
RESEND_API_KEY=
EMAIL_FROM=Flood-Watch <onboarding@resend.dev>

# One-click demo sign-in on /login (server-side only). Turn off in production.
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=
